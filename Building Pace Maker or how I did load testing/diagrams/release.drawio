<mxfile host="drawio">
  <diagram id="release" name="Release pipeline">
    <mxGraphModel dx="1400" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="tag" value="Pushed tag&lt;br&gt;&lt;font color=&quot;#5B6B7B&quot; style=&quot;font-size:12px;font-weight:normal&quot;&gt;private repository&lt;/font&gt;" style="shape=mxgraph.basic.tag;rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2933;fillColor=#F4F6F8;strokeColor=#7B8794;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ci" value="CI on the Xcode 27 runner&lt;br&gt;&lt;font color=&quot;#5B6B7B&quot; style=&quot;font-size:12px;font-weight:normal&quot;&gt;unit tests · release build&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2933;fillColor=#FFF4E5;strokeColor=#D98A1E;" vertex="1" parent="1">
          <mxGeometry x="250" y="146" width="200" height="78" as="geometry" />
        </mxCell>
        <mxCell id="sign" value="Sign and notarize&lt;br&gt;&lt;font color=&quot;#5B6B7B&quot; style=&quot;font-size:12px;font-weight:normal&quot;&gt;Developer ID · Apple notary&lt;br&gt;service · stapled ticket&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2933;fillColor=#FFF4E5;strokeColor=#D98A1E;" vertex="1" parent="1">
          <mxGeometry x="510" y="146" width="200" height="78" as="geometry" />
        </mxCell>
        <mxCell id="private" value="Private release&lt;br&gt;&lt;font color=&quot;#5B6B7B&quot; style=&quot;font-size:12px;font-weight:normal&quot;&gt;DMG · ZIP · checksums&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2933;fillColor=#EEF7EE;strokeColor=#4E9A5B;" vertex="1" parent="1">
          <mxGeometry x="770" y="146" width="190" height="78" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="Release notes&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;written in the pull request&lt;/font&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;fillColor=#FFFFFF;strokeColor=#4E9A5B;" vertex="1" parent="1">
          <mxGeometry x="785" y="20" width="160" height="62" as="geometry" />
        </mxCell>
        <mxCell id="public" value="Public repository&lt;br&gt;&lt;font color=&quot;#5B6B7B&quot; style=&quot;font-size:12px;font-weight:normal&quot;&gt;same release · README&lt;br&gt;screenshots · no source&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2933;fillColor=#E8F1FD;strokeColor=#4A7FD4;" vertex="1" parent="1">
          <mxGeometry x="1080" y="146" width="200" height="78" as="geometry" />
        </mxCell>
        <mxCell id="guard" value="Guard&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;anything but README and&lt;br&gt;images stops the publish&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#9B3D3D;fillColor=#FDF0F0;strokeColor=#C96A6A;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1095" y="288" width="170" height="62" as="geometry" />
        </mxCell>

        <mxCell id="b1" style="endArrow=block;endFill=1;html=1;strokeColor=#7B8794;strokeWidth=1.8;" edge="1" parent="1" source="tag" target="ci"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b2" style="endArrow=block;endFill=1;html=1;strokeColor=#D98A1E;strokeWidth=1.8;" edge="1" parent="1" source="ci" target="sign"><mxGeometry relative="1" as="geometry" /></mxCell>
