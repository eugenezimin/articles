        <mxCell id="b4" value="mirror" style="endArrow=block;endFill=1;html=1;strokeColor=#4A7FD4;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12;fontColor=#4A7FD4;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="private" target="public"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b5" style="endArrow=block;endFill=1;html=1;strokeColor=#4E9A5B;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="notes" target="private"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b6" style="endArrow=none;html=1;strokeColor=#C96A6A;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="public" target="guard"><mxGeometry relative="1" as="geometry" /></mxCell>
