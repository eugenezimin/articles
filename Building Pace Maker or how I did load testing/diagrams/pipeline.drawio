<mxfile host="drawio">
  <diagram id="pipeline" name="Request pipeline">
    <mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="pacer" value="Rate pacer&lt;br&gt;&lt;font color=&quot;#5B6B7B&quot; style=&quot;font-size:12px;font-weight:normal&quot;&gt;releases requests at the&lt;br&gt;target rate, never waits&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2933;fillColor=#FFF4E5;strokeColor=#D98A1E;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="180" height="78" as="geometry" />
        </mxCell>
        <mxCell id="backlog" value="Bounded backlog&lt;br&gt;&lt;font color=&quot;#5B6B7B&quot; style=&quot;font-size:12px;font-weight:normal&quot;&gt;work waiting for&lt;br&gt;a free connection&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2933;fillColor=#FFF4E5;strokeColor=#D98A1E;" vertex="1" parent="1">
          <mxGeometry x="270" y="160" width="180" height="78" as="geometry" />
        </mxCell>
        <mxCell id="shed" value="Shed&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;counted, never queued forever&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#9B3D3D;fillColor=#FDF0F0;strokeColor=#C96A6A;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="275" y="30" width="170" height="58" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="Adaptive connection gate&lt;br&gt;&lt;font color=&quot;#5B6B7B&quot; style=&quot;font-size:12px;font-weight:normal&quot;&gt;how many requests may&lt;br&gt;be in flight right now&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2933;fillColor=#FFF4E5;strokeColor=#D98A1E;" vertex="1" parent="1">
          <mxGeometry x="500" y="160" width="190" height="78" as="geometry" />
        </mxCell>
        <mxCell id="workers" value="Worker pool&lt;br&gt;&lt;font color=&quot;#5B6B7B&quot; style=&quot;font-size:12px;font-weight:normal&quot;&gt;fixed size, nothing&lt;br&gt;spawned per request&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2933;fillColor=#FFF4E5;strokeColor=#D98A1E;" vertex="1" parent="1">
          <mxGeometry x="740" y="160" width="180" height="78" as="geometry" />
        </mxCell>
        <mxCell id="target" value="Target endpoint&lt;br&gt;&lt;font color=&quot;#5B6B7B&quot; style=&quot;font-size:12px;font-weight:normal&quot;&gt;any HTTP method&lt;/font&gt;" style="shape=cloud;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2933;fillColor=#F4F6F8;strokeColor=#7B8794;" vertex="1" parent="1">
          <mxGeometry x="1020" y="150" width="170" height="98" as="geometry" />
        </mxCell>

        <mxCell id="counters" value="Outcome counters&lt;br&gt;&lt;font color=&quot;#5B6B7B&quot; style=&quot;font-size:12px;font-weight:normal&quot;&gt;sent · succeeded · failed&lt;br&gt;shed · latency&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2933;fillColor=#EEF7EE;strokeColor=#4E9A5B;" vertex="1" parent="1">
          <mxGeometry x="740" y="330" width="180" height="78" as="geometry" />
        </mxCell>
        <mxCell id="sampler" value="Sampler&lt;br&gt;&lt;font color=&quot;#5B6B7B&quot; style=&quot;font-size:12px;font-weight:normal&quot;&gt;one tick per interval,&lt;br&gt;rates per second&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2933;fillColor=#EEF7EE;strokeColor=#4E9A5B;" vertex="1" parent="1">
          <mxGeometry x="500" y="330" width="190" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="Chart and stats&lt;br&gt;&lt;font color=&quot;#5B6B7B&quot; style=&quot;font-size:12px;font-weight:normal&quot;&gt;what the user sees&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#1F2933;fillColor=#E8F1FD;strokeColor=#4A7FD4;" vertex="1" parent="1">
          <mxGeometry x="220" y="330" width="180" height="78" as="geometry" />
        </mxCell>

        <mxCell id="a1" style="endArrow=block;endFill=1;html=1;strokeColor=#D98A1E;strokeWidth=1.8;" edge="1" parent="1" source="pacer" target="backlog"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="endArrow=block;endFill=1;html=1;strokeColor=#D98A1E;strokeWidth=1.8;" edge="1" parent="1" source="backlog" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" style="endArrow=block;endFill=1;html=1;strokeColor=#D98A1E;strokeWidth=1.8;" edge="1" parent="1" source="gate" target="workers"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" value="requests" style="endArrow=block;endFill=1;html=1;strokeColor=#D98A1E;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12;fontColor=#D98A1E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="workers" target="target"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" value="when full" style="endArrow=block;endFill=1;html=1;strokeColor=#C96A6A;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=12;fontColor=#9B3D3D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backlog" target="shed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a6" value="outcomes" style="endArrow=block;endFill=1;html=1;strokeColor=#4E9A5B;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12;fontColor=#4E9A5B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="workers" target="counters"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a7" style="endArrow=block;endFill=1;html=1;strokeColor=#4E9A5B;strokeWidth=1.8;" edge="1" parent="1" source="counters" target="sampler"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a8" value="ticks" style="endArrow=block;endFill=1;html=1;strokeColor=#4A7FD4;strokeWidth=1.8;fontFamily=Helvetica;fontSize=12;fontColor=#4A7FD4;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sampler" target="ui"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a9" value="latency · throughput · errors" style="endArrow=block;endFill=1;html=1;strokeColor=#7B5EA7;strokeWidth=1.8;dashed=1;fontFamily=Helvetica;fontSize=12;fontColor=#7B5EA7;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sampler" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
