<mxfile host="drawio">
  <diagram id="architecture" name="Architecture">
    <mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- UI layer -->
        <mxCell id="ui" value="SwiftUI interface" style="swimlane;rounded=1;arcSize=6;startSize=32;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1F2933;fillColor=#E8F1FD;strokeColor=#4A7FD4;swimlaneFillColor=#F6F9FE;html=1;" vertex="1" parent="1">
