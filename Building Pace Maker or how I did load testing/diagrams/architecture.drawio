        <mxCell id="e6" value="observed state" style="endArrow=block;endFill=1;html=1;strokeColor=#4E9A5B;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=12;fontColor=#4E9A5B;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=0;entryX=0.65;entryY=1;" edge="1" parent="1" source="model" target="ui">
          <mxGeometry relative="1" as="geometry" />
