          <mxGeometry x="560" y="214" width="120" height="58" as="geometry" />
        </mxCell>

        <!-- Facade -->
        <mxCell id="facade" value="Engine facade&lt;br&gt;&lt;font color=&quot;#5B6B7B&quot; style=&quot;font-size:12px;font-weight:normal&quot;&gt;run lifecycle · event stream&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1F2933;fillColor=#FFF4E5;strokeColor=#D98A1E;" vertex="1" parent="1">
          <mxGeometry x="200" y="336" width="320" height="62" as="geometry" />
