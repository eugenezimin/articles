        <!-- Down: actions -->
        <mxCell id="e1" value="actions" style="endArrow=block;endFill=1;html=1;strokeColor=#4A7FD4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#4A7FD4;labelBackgroundColor=#FFFFFF;exitX=0.35;exitY=1;entryX=0.35;entryY=0;" edge="1" parent="1" source="ui" target="model">
