          <mxGeometry x="440" y="48" width="180" height="62" as="geometry" />
        </mxCell>

        <!-- Model -->
        <mxCell id="model" value="Observable session model&lt;br&gt;&lt;font color=&quot;#5B6B7B&quot; style=&quot;font-size:12px;font-weight:normal&quot;&gt;run state · totals · chart series · responses&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1F2933;fillColor=#EEF7EE;strokeColor=#4E9A5B;" vertex="1" parent="1">
          <mxGeometry x="200" y="210" width="320" height="66" as="geometry" />
